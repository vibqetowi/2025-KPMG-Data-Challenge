@enduml

@startuml KPMG Data ETL Flow

title KPMG Data Challenge - Simplified Data Flow

' Styling
skinparam linetype ortho
skinparam ArrowColor 00338D
skinparam BorderColor 00338D
skinparam noteBackgroundColor 0091DA
skinparam noteFontColor White

' Core Components
cloud "Salesforce" as sf
note bottom: Future Data Source

[KPMG Case Data.xlsx] as excel
note bottom: Current Data Source

[ETL Pipeline] as pipeline
note bottom: Data Processing\nand Transformation

database "SQL Server DB" as db

[Power BI] as powerbi

package "Advanced Analysis" {
    [Resource Optimization] as analysis
    note bottom: MILP Optimization\nEVM Analysis
}

' Flow
sf ...> pipeline : Future
excel --> pipeline
pipeline --> db
db --> powerbi
db <--> analysis

@enduml
